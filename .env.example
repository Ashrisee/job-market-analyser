# CareerScope AI - Environment Variables
# Copy this file to .env in the project root and fill in your API keys

# JSearch API (RapidAPI) - https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your_jsearch_rapidapi_key_here

# Adzuna API - https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Flask Configuration
FLASK_DEBUG=true
FLASK_PORT=5001
